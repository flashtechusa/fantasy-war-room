# ---------------------------------------------------------------------------
# Fantasy War Room configuration
#
# Copy to `.env` and fill in.  `.env` is git-ignored -- never commit real
# credentials.  Every value below can also be supplied as a real environment
# variable (which wins over the file), which is what you want in Docker.
# ---------------------------------------------------------------------------

# The bare ESPN_* names below are also accepted everywhere the FWR_ESPN_* ones
# are (ESPN_LEAGUE_ID, ESPN_YEAR / ESPN_SEASON, ESPN_SWID / SWID, ESPN_S2), so
# credentials copied from anywhere else can be pasted straight in.  When both
# are present, the FWR_-prefixed name wins.
#
# Set FWR_ENV_FILE to read a different file than `.env` (handy for a second
# league), or to an empty string to ignore it entirely.

# --- Accounts ---------------------------------------------------------------
# Off by default: the app runs as one implicit local account, signs you in
# automatically and never shows a login screen.  That is what you want on your
# own machine.
#
# Turn it on to host the app for other people.  Each account then signs in with
# a password and connects its own leagues; nobody can see anyone else's league,
# credentials or roster.  One account can hold several leagues -- an ESPN one
# and a Yahoo one -- and switch between them from the header.
FWR_MULTI_USER=false

# Whether strangers may create accounts.  Set to false to run a closed beta and
# make accounts yourself.
FWR_ALLOW_REGISTRATION=true

# How long a sign-in lasts, in days.
FWR_SESSION_DAYS=30

# Send the session cookie only over HTTPS.  Leave this on in production; turn it
# off only to test multi-user over plain http on localhost.
FWR_SECURE_COOKIES=true

# --- Platform ---------------------------------------------------------------
# Which platform this install reads: `espn` or `yahoo`.  A league lives on one
# of them, so this decides which block of credentials below is used.  Everything
# past the import -- rankings, lineups, waivers, trades -- is identical.
FWR_PLATFORM=espn

# --- ESPN league ------------------------------------------------------------
# Found in your league URL:
#   https://fantasy.espn.com/football/league?leagueId=123456&seasonId=2026
FWR_ESPN_LEAGUE_ID=
FWR_ESPN_SEASON=2026

# --- ESPN private-league credentials ---------------------------------------
# Only required for PRIVATE leagues.  Leave blank for public leagues.
#
# How to find them (desktop browser, logged in to fantasy.espn.com):
#   1. Open DevTools -> Application -> Cookies -> https://fantasy.espn.com
#   2. Copy the value of the `SWID` cookie   (includes the curly braces)
#   3. Copy the value of the `espn_s2` cookie (long URL-encoded string)
FWR_ESPN_SWID=
FWR_ESPN_S2=

# --- Yahoo league -----------------------------------------------------------
# Only needed when FWR_PLATFORM=yahoo.  Yahoo has no cookie shortcut: it needs a
# free app registered at https://developer.yahoo.com/apps/create (Fantasy Sports,
# Read permission) and a one-time OAuth handshake, which the League screen walks
# you through.  See docs/yahoo.md.
#
# The CLIENT ID and SECRET belong to the installation -- one Yahoo developer app
# serves everyone using this server.  The league id and the tokens belong to a
# person, so on a multi-user install they are stored per account and the two
# below are only used to seed the first connection.
#
# The league id is the number in your league URL:
#   https://football.fantasysports.yahoo.com/f1/123456
FWR_YAHOO_LEAGUE_ID=
FWR_YAHOO_CLIENT_ID=
FWR_YAHOO_CLIENT_SECRET=

# `oob` means Yahoo shows you a code to paste back into the app, which is what
# works on a laptop with no public HTTPS address.  Set this to a redirect URL
# instead only if you registered one on the Yahoo app, e.g.
#   https://your-deployment/api/yahoo/auth/callback
FWR_YAHOO_REDIRECT_URI=oob

# Written by the app once you connect; you should not need to set these by hand.
FWR_YAHOO_ACCESS_TOKEN=
FWR_YAHOO_REFRESH_TOKEN=

# --- Draft ------------------------------------------------------------------
# Which fantasy team in the league is yours.  Set either one; TEAM_ID wins.
# Yahoo identifies your team on its own, so this is usually unnecessary there.
# You can look both up on the League Settings page after importing.
FWR_MY_TEAM_ID=
FWR_MY_TEAM_NAME=

# Your draft slot (1 = first overall pick).  Leave blank to auto-detect from
# the ESPN draft order once it is published.
FWR_MY_DRAFT_SLOT=

# --- Application ------------------------------------------------------------
# SQLite by default.  Any SQLAlchemy URL works if you outgrow it.
FWR_DATABASE_URL=sqlite:///./data/fantasy_war_room.db

# Run without ESPN entirely -- generates a realistic demo league + player pool.
# Handy for trying the app out, for tests, and for offline development.
FWR_DEMO_MODE=false

# Seconds to cache the player pool before re-fetching.
FWR_PLAYER_CACHE_TTL=900

# Minimum seconds between ESPN draft polls in Live Draft auto-sync.  ESPN has
# no published rate limit; this keeps us to a polite request rate.
FWR_DRAFT_POLL_INTERVAL=10

FWR_HOST=0.0.0.0
FWR_PORT=8000
FWR_LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for the Vite dev server.
FWR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
